.PHONY: help up down restart logs app-refresh db-migrate db-reset db-shell db-clear-users db-list-users backfill-deposit-addresses status ps admin-promote docker-prune

COMPOSE := docker compose -f docker-compose.prod.yml

# Colors for terminal output
CYAN := \033[0;36m
GREEN := \033[0;32m
YELLOW := \033[1;33m
RED := \033[0;31m
NC := \033[0m

help: ## Show this help message
	@echo "$(CYAN)CaspianEx OTC Exchange - Production Commands:$(NC)"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""

# ── Docker Compose ──────────────────────────────────────────────────────────

up: ## Start all services
	@echo "$(CYAN)Starting production services...$(NC)"
	$(COMPOSE) up -d
	@echo "$(GREEN)✓ All services started$(NC)"

down: ## Stop all services
	@echo "$(CYAN)Stopping production services...$(NC)"
	$(COMPOSE) down
	@echo "$(GREEN)✓ All services stopped$(NC)"

restart: down up ## Restart all services

app-refresh: ## Rebuild and restart ONLY the app container
	@echo "$(CYAN)Rebuilding app...$(NC)"
	$(COMPOSE) up -d --no-deps --build app
	@echo "$(GREEN)✓ App refreshed$(NC)"

# ── Logs ─────────────────────────────────────────────────────────────────────

logs: ## Follow logs for all services
	$(COMPOSE) logs -f

logs-app: ## Follow logs for app only
	$(COMPOSE) logs -f app

logs-db: ## Follow logs for postgres only
	$(COMPOSE) logs -f postgres

# ── Database ─────────────────────────────────────────────────────────────────

db-migrate: ## Run database migrations
	@echo "$(CYAN)Running migrations...$(NC)"
	$(COMPOSE) up migrate
	@echo "$(GREEN)✓ Migrations complete$(NC)"

db-shell: ## Open PostgreSQL shell
	$(COMPOSE) exec postgres psql -U $${DB_USER:-exchange} -d $${DB_NAME:-exchange_db}

db-reset: ## Reset database — WARNING: deletes ALL data
	@echo "$(RED)⚠️  WARNING: This will delete ALL production data.$(NC)"
	@echo "$(YELLOW)You have 5 seconds to cancel (Ctrl+C)...$(NC)"
	@sleep 5
	$(COMPOSE) down -v
	$(COMPOSE) up -d postgres
	@echo "Waiting for postgres to be ready..."
	@sleep 5
	$(COMPOSE) up migrate
	@echo "$(GREEN)✓ Database reset complete$(NC)"

# ── Backfill ──────────────────────────────────────────────────────────────────

backfill-deposit-addresses: ## Create missing crypto deposit addresses for all existing users
	@echo "$(CYAN)Backfilling deposit addresses...$(NC)"
	$(COMPOSE) run --rm app ./backfill_deposit_addresses
	@echo "$(GREEN)✓ Done$(NC)"

# ── Admin ─────────────────────────────────────────────────────────────────────

db-list-users: ## List latest 50 client users
	$(COMPOSE) exec postgres psql -U $${DB_USER:-exchange} -d $${DB_NAME:-exchange_db} \
		-c "SELECT id, email, first_name, last_name, is_active, created_at FROM users WHERE role = 'client' ORDER BY created_at DESC LIMIT 50;"

db-clear-users: ## ⚠️  Delete ALL client users and their data
	@echo "$(RED)⚠️  WARNING: This will permanently delete ALL client users in production.$(NC)"
	@echo "$(YELLOW)You have 5 seconds to cancel (Ctrl+C)...$(NC)"
	@sleep 5
	$(COMPOSE) exec postgres psql -U $${DB_USER:-exchange} -d $${DB_NAME:-exchange_db} \
		-c "DELETE FROM otc_orders WHERE user_id IN (SELECT id FROM users WHERE role = 'client'); \
		    DELETE FROM users WHERE role = 'client';"
	@echo "$(GREEN)✓ All client users cleared$(NC)"

admin-promote: ## Promote a user to admin — usage: make admin-promote EMAIL=user@example.com
	@if [ -z "$(EMAIL)" ]; then \
		echo "$(RED)✗ EMAIL is required. Usage: make admin-promote EMAIL=user@example.com$(NC)"; \
		exit 1; \
	fi
	@echo "$(CYAN)Promoting $(EMAIL) to admin...$(NC)"
	$(COMPOSE) exec postgres psql -U $${DB_USER:-exchange} -d $${DB_NAME:-exchange_db} \
		-c "UPDATE users SET role = 'admin' WHERE email = '$(EMAIL)';"
	@echo "$(GREEN)✓ Done. Verify with: make admin-list$(NC)"

admin-list: ## List all admin users
	$(COMPOSE) exec postgres psql -U $${DB_USER:-exchange} -d $${DB_NAME:-exchange_db} \
		-c "SELECT id, email, role, created_at FROM users WHERE role = 'admin';"

# ── Status ────────────────────────────────────────────────────────────────────

status: ## Show status of all services
	$(COMPOSE) ps

ps: status ## Alias for status

# ── Maintenance ───────────────────────────────────────────────────────────────

docker-prune: ## Remove unused Docker images and dangling layers (keeps volumes)
	@echo "$(YELLOW)⚠️  This will remove unused Docker resources. Press Ctrl+C to cancel...$(NC)"
	@sleep 3
	docker system prune -af
	@echo "$(GREEN)✓ Docker cleanup complete$(NC)"

.DEFAULT_GOAL := help
